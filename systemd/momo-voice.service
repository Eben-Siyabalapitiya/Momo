[Unit]
Description=Momo voice assistant
After=network-online.target sound.target momo-wifi-check.service
Wants=network-online.target

[Service]
Type=simple
User=castlers
WorkingDirectory=/home/castlers/momo
ExecStartPre=-/usr/bin/sudo systemctl stop momo-boot-splash.service
ExecStart=/usr/bin/python3 -u /home/castlers/momo/voice.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target