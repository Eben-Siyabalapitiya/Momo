[Unit]
Description=Momo servo control web panel
After=network-online.target momo-wifi-check.service
Wants=network-online.target

[Service]
Type=simple
User=castlers
WorkingDirectory=/home/castlers/momo
ExecStart=/usr/bin/python3 /home/castlers/momo/web.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target